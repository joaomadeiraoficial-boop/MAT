<?php
declare(strict_types=1);

function get_categories(): array {
    $base=['Comunicação','Computação','Energia','Engenharia','Medicina','Ciência','Transporte','Materiais','Agricultura','Outros'];
    if(!db())return $base;
    $found=db()->query('SELECT DISTINCT categoria FROM marcos ORDER BY categoria LIMIT 200')->fetchAll(PDO::FETCH_COLUMN);
    return array_values(array_unique(array_merge($base,array_filter($found,fn($c)=>trim((string)$c)!==''))));
}
function get_periods(): array { return ['Pré-história','Antiguidade','Idade Média','Idade Moderna','Era Industrial','Era Digital','Era Contemporânea']; }
function get_markers(array $filter=[], int $page=1, int $perPage=12): array {
    $pdo=db(); $page=max(1,$page);$perPage=max(1,min(100,$perPage));$offset=($page-1)*$perPage;
    if(!$pdo) return ['rows'=>[], 'total'=>0, 'page'=>$page, 'pages'=>1];
    $where=["status <> 'demonstracao'"];$params=[];
    if(!empty($filter['q'])){ $where[]='(titulo LIKE :q1 OR descricao LIKE :q2 OR local LIKE :q3)';$q='%'.trim((string)$filter['q']).'%';$params+=['q1'=>$q,'q2'=>$q,'q3'=>$q]; }
    if(!empty($filter['categoria'])){$where[]='categoria = :categoria';$params['categoria']=$filter['categoria'];}
    if(!empty($filter['periodo'])){$where[]='periodo = :periodo';$params['periodo']=$filter['periodo'];}
    if(!empty($filter['status'])){$where[]='status = :status';$params['status']=$filter['status'];}
    $condition=$where?'WHERE '.implode(' AND ',$where):'';
    $stmt=$pdo->prepare('SELECT COUNT(*) FROM marcos '.$condition);$stmt->execute($params);$total=(int)$stmt->fetchColumn();
    $sort=($filter['ordem']??'ano_asc') === 'ano_desc' ? 'ano DESC, id DESC' : 'ano ASC, id ASC';
    $stmt=$pdo->prepare("SELECT * FROM marcos $condition ORDER BY $sort LIMIT :limit OFFSET :offset");
    foreach($params as $key=>$value)$stmt->bindValue(':'.$key,$value);
    $stmt->bindValue(':limit',$perPage,PDO::PARAM_INT);$stmt->bindValue(':offset',$offset,PDO::PARAM_INT);$stmt->execute();
    return ['rows'=>$stmt->fetchAll(),'total'=>$total,'page'=>$page,'pages'=>max(1,(int)ceil($total/$perPage))];
}
function find_marker(int $id): ?array {
    if(!$id)return null;
    if(!db()) return null;
    $stmt=db()->prepare('SELECT * FROM marcos WHERE id = ? AND status <> \'demonstracao\' LIMIT 1');$stmt->execute([$id]);return $stmt->fetch() ?: null;
}
function all_markers(?string $status = null): array {
    if(!db()) return $status ? array_values(array_filter(sample_markers(),fn($m)=>$m['status']===$status)) : sample_markers();
    if($status){$s=db()->prepare('SELECT m.*, (SELECT COUNT(*) FROM marco_fontes mf WHERE mf.marco_id=m.id) AS fonte_vinculada FROM marcos m WHERE status=? ORDER BY ano ASC,id ASC');$s->execute([$status]);return $s->fetchAll();}
    return db()->query('SELECT m.*, (SELECT COUNT(*) FROM marco_fontes mf WHERE mf.marco_id=m.id) AS fonte_vinculada FROM marcos m WHERE m.status <> \'demonstracao\' ORDER BY ano ASC,id ASC')->fetchAll();
}
function app_stats(): array {
    $rows=all_markers();$cats=[];$periods=[];$states=['aprovado'=>0,'pendente'=>0,'importado'=>0,'demonstracao'=>0,'rejeitado'=>0];
    foreach($rows as $r){$cat=$r['categoria']?:'Outros';$period=$r['periodo']?:'Indefinido';$cats[$cat]=($cats[$cat]??0)+1;$periods[$period]=($periods[$period]??0)+1;$states[$r['status']]=($states[$r['status']]??0)+1;}
    arsort($cats);$years=array_map('intval',array_column($rows,'ano'));
    return ['total'=>count($rows),'min_year'=>$years?min($years):null,'max_year'=>$years?max($years):null,'categories'=>$cats,'periods'=>$periods,'states'=>$states];
}
function import_batches(): array {
    if(!db())return [];
    return db()->query('SELECT l.*, (SELECT COUNT(*) FROM import_itens i WHERE i.lote_id=l.id) as quantidade FROM import_lotes l ORDER BY l.id DESC LIMIT 20')->fetchAll();
}
function import_pending(int $limit=100): array {
    if(!db())return [];
    $stmt=db()->prepare('SELECT i.*, l.arquivo_nome FROM import_itens i INNER JOIN import_lotes l ON l.id=i.lote_id WHERE i.status = ? ORDER BY i.id DESC LIMIT ?');
    $stmt->bindValue(1,'pendente');$stmt->bindValue(2,$limit,PDO::PARAM_INT);$stmt->execute();return $stmt->fetchAll();
}
